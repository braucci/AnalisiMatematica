%% ---------------------------------------------------------------- stili amsthm
% Numerazione unica per tutti gli enunciati, per capitolo: 1.1, 1.2, ...
\declaretheoremstyle[
  headfont=\sffamily\bfseries\color{blu},
  notefont=\sffamily\mdseries\color{blu}, notebraces={(}{)},
  bodyfont=\normalfont\itshape,
  headpunct={.}, postheadspace=0.6em,
  spaceabove=2pt, spacebelow=2pt]{stileTeorema}
\declaretheoremstyle[
  headfont=\sffamily\bfseries\color{rame},
  notefont=\sffamily\mdseries\color{rame}, notebraces={(}{)},
  bodyfont=\normalfont,
  headpunct={.}, postheadspace=0.6em,
  spaceabove=2pt, spacebelow=2pt]{stileDefinizione}
\declaretheoremstyle[
  headfont=\sffamily\bfseries\color{grigio},
  notefont=\sffamily\mdseries\color{grigio}, notebraces={(}{)},
  bodyfont=\normalfont,
  headpunct={.}, postheadspace=0.6em,
  spaceabove=2pt, spacebelow=2pt]{stileNota}

\declaretheorem[style=stileTeorema, name=Teorema, numberwithin=chapter]{teorema}
\declaretheorem[style=stileTeorema, name=Proposizione, sharenumber=teorema]{proposizione}
\declaretheorem[style=stileTeorema, name=Lemma, sharenumber=teorema]{lemma}
\declaretheorem[style=stileTeorema, name=Corollario, sharenumber=teorema]{corollario}
\declaretheorem[style=stileTeorema, name=Assioma, sharenumber=teorema]{assioma}
\declaretheorem[style=stileDefinizione, name=Definizione, sharenumber=teorema]{definizione}
\declaretheorem[style=stileNota, name=Esempio, sharenumber=teorema]{esempio}
\declaretheorem[style=stileNota, name=Osservazione, sharenumber=teorema]{osservazione}
\declaretheorem[style=stileNota, name=Esercizio, sharenumber=teorema]{esercizio}
\declaretheorem[style=stileNota, name=Notazione, sharenumber=teorema]{notazione}

