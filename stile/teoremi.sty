    before skip=10pt plus 2pt, after skip=10pt plus 2pt,
    fontupper=\normalsize},
  scatolaTeorema/.style={scatola, colback=bluchiaro, borderline west={2.5pt}{0pt}{blu}},
  scatolaDefinizione/.style={scatola, colback=ramechiaro, borderline west={2.5pt}{0pt}{rame}},
  scatolaNota/.style={scatola, colback=grigiochiaro, borderline west={2.5pt}{0pt}{grigio}},
}
\tcolorboxenvironment{teorema}{scatolaTeorema}
\tcolorboxenvironment{proposizione}{scatolaTeorema}
\tcolorboxenvironment{lemma}{scatolaTeorema}
\tcolorboxenvironment{corollario}{scatolaTeorema}
\tcolorboxenvironment{assioma}{scatolaTeorema}
\tcolorboxenvironment{definizione}{scatolaDefinizione}
\tcolorboxenvironment{esempio}{scatolaNota}
\tcolorboxenvironment{osservazione}{scatolaNota}
\tcolorboxenvironment{esercizio}{scatolaNota}
\tcolorboxenvironment{notazione}{scatolaNota}

